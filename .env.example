# Copy this file to .env.local in the folder containing package.json.
# Real search requires BOTH credentials from an approved Amadeus production app.
# Until connected, searches fail clearly instead of returning sample fares.
FLIGHT_DATA_MODE=live
AMADEUS_ENVIRONMENT=production
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# For sandbox credentials, use AMADEUS_ENVIRONMENT=test (test fares only).
# To intentionally explore fictional flights, set FLIGHT_DATA_MODE=demo.
# Your public HTTPS origin, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
