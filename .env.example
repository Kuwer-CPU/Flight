# Copy this file to .env.local in the folder containing package.json.
# Select one feed. Amadeus returns fares; Skyscanner partner access can return seller quotes.
# Until connected, searches fail clearly instead of returning sample fares.
# Flyora2.0 customer search defaults to Travelpayouts. Existing API cards are opt-in.
FLIGHT_SEARCH_INTEGRATION=travelpayouts
TRAVELPAYOUTS_EMBED_ENABLED=true
TRAVELPAYOUTS_WHITE_LABEL_ID=23277
# Enter only a hosted White Label URL or iframe code approved in your partner account.
TRAVELPAYOUTS_WHITE_LABEL_URL=
TRAVELPAYOUTS_WIDGET_CODE=
TRAVELPAYOUTS_AFFILIATE_LINKS=true
# Optional comma-separated exact HTTPS origins for officially approved widget resources.
# Add only origins confirmed by Travelpayouts or observed during an authorized deployment check.
TRAVELPAYOUTS_RESOURCE_ORIGINS=
# Settings below apply to the separate FLIGHT_SEARCH_INTEGRATION=api experience.
FLIGHT_DATA_MODE=live
FLIGHT_PROVIDER=amadeus
# Amadeus: matching production key AND secret are required.
AMADEUS_ENVIRONMENT=production
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# For seller comparisons, set FLIGHT_PROVIDER=skyscanner and use an approved partner key.
SKYSCANNER_ENVIRONMENT=production
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
# Confirm the CURRENT partner contract, then select group or per-person. Never guess.
SKYSCANNER_PRICE_BASIS=
# For sandbox credentials, use AMADEUS_ENVIRONMENT=test (test fares only).
# To intentionally explore fictional flights, set FLIGHT_DATA_MODE=demo.
# Your public HTTPS origin, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://flight-ten-steel.vercel.app
# Public business details, displayed on the site. Fill with the actual operator and email.
FLYORA_BUSINESS_NAME=
FLYORA_CONTACT_EMAIL=
# Keep previews out of search indexes. Enable only after actual launch verification.
FLYORA_ALLOW_INDEXING=false
