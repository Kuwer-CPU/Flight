# Leave demo mode enabled until you have a flight-data provider.
FLIGHT_DATA_MODE=demo
# Amadeus test credentials return sandbox data, not bookable production fares.
# Use production credentials and set AMADEUS_ENVIRONMENT=production for live fares.
AMADEUS_ENVIRONMENT=test
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Your public HTTPS origin, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
